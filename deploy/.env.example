# Copy to deploy/.env.staging or deploy/.env.production and fill in. Never commit the filled file.
# Staging and production use different values for everything below (never share keys).
# Start: docker compose -f deploy/docker-compose.yml --env-file deploy/.env.<environment> up -d --wait
ELOKA_ENV_FILE=.env.staging          # this file's own name, relative to deploy/ (the services read it too)

# --- Site ---
ELOKA_ENVIRONMENT=staging            # staging | production (both refuse fakes and test keys)
ELOKA_DOMAIN=apply.example.in        # public host name; DNS must point at this server
ELOKA_PUBLIC_URL=https://apply.example.in
ELOKA_ACME_EMAIL=ops@example.in
ELOKA_VERSION=latest                 # image tag to run (v1.2.3); see RUNBOOK "Deploy"
ELOKA_IMAGE_PREFIX=ghcr.io/sourya-07/elokaa

# --- Database ---
ELOKA_DB_USERNAME=eloka_partner
ELOKA_DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- Keys for personal data (openssl rand -base64 32 for each; keep them in the secrets manager) ---
ELOKA_CRYPTO_FIELD_KEY=
ELOKA_CRYPTO_INDEX_KEY=

# --- Providers (ADR-0004). none = refuse; fakes are not allowed here ---
ELOKA_OTP_PROVIDER=eps
ELOKA_IDENTITY_PROVIDER=eps
ELOKA_CREDIT_BUREAU=none             # no bureau contracted yet (docs/OPEN_QUESTIONS.md Q-1)
ELOKA_MALWARE_SCANNER=clamav
ELOKA_EPS_BASE_URL=https://staging.eko.in/ekoapi/v3   # production: https://api.eko.in/ekoicici/v3
ELOKA_EPS_DEVELOPER_KEY=
ELOKA_EPS_ACCESS_KEY=
ELOKA_EPS_INITIATOR_ID=
ELOKA_EPS_CSP_ID=

# --- Staff console ---
ELOKA_STAFF_GOOGLE_CLIENT_ID=        # OAuth client of the staff console (server and web app)
ELOKA_STAFF_GOOGLE_DOMAIN=eko.co.in
