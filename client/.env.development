# Safe local defaults (committed). Personal overrides go in .env.development.local (gitignored).
# Where the BFF proxy reaches the server (server-side only, never sent to the browser)
ELOKA_SERVER_URL=http://localhost:8091
# Staff console: OTP sign-in for the seeded local staff (the server allows it only in local/test)
NEXT_PUBLIC_STAFF_OTP_SIGN_IN=true
